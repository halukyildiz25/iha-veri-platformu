# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
*.egg-info/

# --- Rust ---
**/target/

# DataProcessingManagement is its own nested git repo (required at runtime:
# dagster/postgres_catalog.py resolves pipeline identity via git, and the
# container only ever sees this folder, not this outer repo's .git). This
# outer repo tracks its files as plain content instead of a submodule
# gitlink, so only the inner .git internals are excluded here.
DataProcessingManagement/.git/

# --- generated / runtime data (regenerate via dvc repro or the app itself) ---
DataProcessingManagement/data/raw/
DataProcessingManagement/data/cleaned/mx_tab_inbox/
DataProcessingManagement/dagster/data/raw/
DataProcessingManagement/dagster/tmp/
DataProcessingManagement/dagster/.tmp_dagster_home_*/
DataProcessingManagement/local_data/
DataProcessingManagement/reports/
DataProcessingManagement/testdata/
DataProcessingManagement/.dvc/cache/
DataProcessingManagement/.dvc/tmp/
*.tab
*.parquet
.env
